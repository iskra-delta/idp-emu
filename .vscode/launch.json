{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "GDP Floppy",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/bin/idp-emu",
      "args": [
        "--model",
        "gdp",
        "--rom",
        "${workspaceFolder}/roms/partner_gdp.rom",
        "--disk",
        "${workspaceFolder}/disks/fdd-partner-g.img"
      ],
      "cwd": "${workspaceFolder}",
      "stopAtEntry": false,
      "externalConsole": false,
      "miDebuggerArgs": "-iex \"set debuginfod enabled off\"",
      "launchCompleteCommand": "exec-run",
      "symbolLoadInfo": {
        "loadAll": false
      },
      "logging": {
        "trace": true,
        "traceResponse": true,
        "engineLogging": true
      },
      "environment": [
        { "name": "DISPLAY", "value": ":0" },
        { "name": "WAYLAND_DISPLAY", "value": "wayland-0" }
      ],
      "MIMode": "gdb",
      "miDebuggerPath": "${workspaceFolder}/tools/gdb-no-debuginfod.sh",
      "preLaunchTask": "CMake Build Debug",
      "setupCommands": [
        {
          "description": "Enable async MI so Pause/interrupt works while the target is running",
          "text": "-gdb-set mi-async on",
          "ignoreFailures": true
        },
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        },
        {
          "description": "Disable pagination in gdb",
          "text": "set pagination off",
          "ignoreFailures": true
        }
      ]
    }
  ]
}
