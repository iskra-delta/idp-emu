{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Iskra Delta Partner Emulator",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/bin/idp-emu",
      "args": [
        "--rom", "${workspaceFolder}/roms/partner_crt.rom",
        "--disk", "${workspaceFolder}/disks/boot.img"
      ]
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [],
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb",
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ],
      "preLaunchTask": "CMake Build"
    }
  ]
}
