{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Partner GDP (Floppy)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/bin/idp-emu",
      "args": [
        "--model", "gdp",
        "--rom", "${workspaceFolder}/roms/partner_gdp.rom",
        "--disk", "${workspaceFolder}/disks/fdd-partner-g.img"
      ],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [],
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb",
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ],
      "preLaunchTask": "CMake Build"
    },
    {
      "name": "Debug Partner GDP (Empty HDD)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/bin/idp-emu",
      "args": [
        "--model", "gdp",
        "--rom", "${workspaceFolder}/roms/partner_gdp.rom",
        "--hdd", "${workspaceFolder}/disks/hdd-partner-g-empty.img"
      ],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [],
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb",
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ],
      "preLaunchTask": "CMake Build"
    },
    {
      "name": "Debug Partner P (Floppy)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/bin/idp-emu",
      "args": [
        "--model", "crt",
