{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "CMake Configure RelWithDebInfo",
      "type": "shell",
      "command": "cmake",
      "args": [
        "-S",
        "${workspaceFolder}",
        "-B",
        "${workspaceFolder}/build",
        "-DCMAKE_BUILD_TYPE=RelWithDebInfo"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$gcc"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": false
      }
    },
    {
      "label": "CMake Build RelWithDebInfo",
      "type": "shell",
      "command": "cmake",
      "args": [
        "--build",
        "${workspaceFolder}/build",
        "-j4"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": [
        "CMake Configure RelWithDebInfo"
      ],
      "dependsOrder": "sequence",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        "$gcc"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": false
      }
    },
    {
      "label": "Build PartOS ROM",
      "type": "shell",
      "command": "make",
      "args": [
        "-C",
        "${workspaceFolder}/partos"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$gcc"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": false
      }
    },
    {
      "label": "Build PartOS Disks",
      "type": "shell",
      "command": "python3",
      "args": [
        "${workspaceFolder}/tools/mkdosdisk.py",
        "${workspaceFolder}/disks"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": false
      }
    },
    {
      "label": "Build Emulator + PartOS",
      "dependsOn": [
        "CMake Build RelWithDebInfo",
        "Build PartOS ROM",
        "Build PartOS Disks"
      ],
      "dependsOrder": "sequence",
      "problemMatcher": []
    }
  ]
}
