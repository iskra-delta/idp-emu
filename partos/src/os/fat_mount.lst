                                    352             ;; ----------------------------------------------------------------
                                    353             ;; fat_mount_from_mbr$() -> <hl> rc
                                    354             ;; ----------------------------------------------------------------
                                    355             ;; reads the second half of the PC-style MBR, validates the 0x55aa
                                    356             ;; signature and scans up to four partition entries. for each non-
                                    357             ;; empty entry we try the stored start value directly and, if that
                                    358             ;; fails, doubled. this lets us tolerate either 256-byte or 512-byte
                                    359             ;; partition-base conventions without hardcoding one forever.
                                    360             ;; ----------------------------------------------------------------
    000001A6                        361 fat_mount_from_mbr$:
    000001A6 AF               [ 4]  362             xor     a
    000001A7 32r00r00         [13]  363             ld      (fat_mbr_unsupported$),a
                                    364 
    000001AA 2Ar00r00         [16]  365             ld      hl,(fat_work_dev$)
    000001AD 11 01 00         [10]  366             ld      de,#1
    000001B0 CDr00r00         [17]  367             call    fat_read_block$
    000001B3 7C               [ 4]  368             ld      a,h
    000001B4 B5               [ 4]  369             or      l
    000001B5 C0               [11]  370             ret     nz
                                    371 
    000001B6 3ArFEr00         [13]  372             ld      a,(fat_sector$ + FATMBR_SIG_LO)
    000001B9 FE 55            [ 7]  373             cp      #0x55
    000001BB C2r57r02         [10]  374             jp      nz,fmm_corrupt$
    000001BE 3ArFFr00         [13]  375             ld      a,(fat_sector$ + FATMBR_SIG_HI)
    000001C1 FE AA            [ 7]  376             cp      #0xaa
    000001C3 C2r57r02         [10]  377             jp      nz,fmm_corrupt$
                                    378 
    000001C6 21rBEr00         [10]  379             ld      hl,#fat_sector$ + FATMBR_PART0
    000001C9 06 04            [ 7]  380             ld      b,#4
    000001CB                        381 fmm_scan$:
    000001CB C5               [11]  382             push    bc
    000001CC E5               [11]  383             push    hl                  ; original entry pointer for this round
                                    384 
    000001CD 11 04 00         [10]  385             ld      de,#FATMBR_TYPE
    000001D0 19               [11]  386             add     hl,de
    000001D1 7E               [ 7]  387             ld      a,(hl)
    000001D2 B7               [ 4]  388             or      a
    000001D3 28 69            [12]  389             jr      z,fmm_next$
                                    390 
    000001D5 11 08 00         [10]  391             ld      de,#(FATMBR_SIZE - FATMBR_TYPE)
    000001D8 19               [11]  392             add     hl,de
    000001D9 7E               [ 7]  393             ld      a,(hl)
    000001DA 23               [ 6]  394             inc     hl
    000001DB B6               [ 7]  395             or      (hl)
    000001DC 23               [ 6]  396             inc     hl
    000001DD B6               [ 7]  397             or      (hl)
    000001DE 23               [ 6]  398             inc     hl
    000001DF B6               [ 7]  399             or      (hl)
    000001E0 28 5C            [12]  400             jr      z,fmm_next$
                                    401 
    000001E2 E1               [10]  402             pop     hl                  ; restore entry pointer
    000001E3 E5               [11]  403             push    hl
    000001E4 11 08 00         [10]  404             ld      de,#FATMBR_START
    000001E7 19               [11]  405             add     hl,de
    000001E8 CDr00r00         [17]  406             call    fat_load_de$        ; de = low 16 bits of start
    000001EB ED 53r00r00      [20]  407             ld      (fat_candidate_base$),de
    000001EF 23               [ 6]  408             inc     hl
    000001F0 23               [ 6]  409             inc     hl
    000001F1 7E               [ 7]  410             ld      a,(hl)
    000001F2 23               [ 6]  411             inc     hl
    000001F3 B6               [ 7]  412             or      (hl)
    000001F4 28 07            [12]  413             jr      z,fmm_try_direct$
    000001F6 3E 01            [ 7]  414             ld      a,#1
    000001F8 32r00r00         [13]  415             ld      (fat_mbr_unsupported$),a
    000001FB 18 41            [12]  416             jr      fmm_next$
                                    417 
    000001FD                        418 fmm_try_direct$:
    000001FD 2Ar00r00         [16]  419             ld      hl,(fat_work_dev$)
    00000200 ED 5Br00r00      [20]  420             ld      de,(fat_candidate_base$)
