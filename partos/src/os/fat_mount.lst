                                      1             ;; fat_mount.s
                                      2             ;;
                                      3             ;; FAT12/FAT16 mount parser and async mount submit paths.
                                      4             ;;
                                      5             ;; this file owns everything needed to turn a block device into one
                                      6             ;; mounted fat_fs_t:
                                      7             ;;   - boot-sector plausibility checks
                                      8             ;;   - full FAT12/FAT16 BPB parsing
                                      9             ;;   - MBR partition probing for hard disks
                                     10             ;;   - public async mount submission entry points
                                     11             ;;   - worker-side execution of queued mount requests
                                     12             ;;
                                     13             ;; it intentionally stops at metadata discovery. no directory walk
                                     14             ;; or file data access happens here; that lives in fat_lookup.s and
                                     15             ;; later file I/O modules. the split keeps mount-time code compact
                                     16             ;; and lets us optimize parsing without mixing it with path logic.
                                     17             ;; ----------------------------------------------------------------
                                     18             ;; 2026-06-16   tstih
                                     19             .module fat_mount
                                     20 
                                     21             .include "fat.inc"
                                      1             ;; fat.inc
                                      2             ;;
                                      3             ;; shared FAT ABI/constants for the assembly implementation.
                                      4             ;;
                                      5             ;; this include is the contract between:
                                      6             ;;   - the public C header (include/fat.h)
                                      7             ;;   - the shared worker core (fat.s)
                                      8             ;;   - mount-time logic (fat_mount.s)
                                      9             ;;   - path lookup logic (fat_lookup.s)
                                     10             ;;
                                     11             ;; public structure offsets MUST stay in lock-step with fat.h.
                                     12             ;; private request/layout values are kept here so the split asm
                                     13             ;; files can share one exact view of queue nodes and scratch state.
                                     14             ;;
                                     15             ;; 2026-06-16   tstih
                                     16 
                                     17             ;; --- public return codes (16-bit signed) ------------------------
                         00000000    18             .equ    FAT_OK,                 0x0000
                         0000FFFF    19             .equ    FAT_ENOMEM,             0xffff
                         0000FFFE    20             .equ    FAT_EINVAL,             0xfffe
                         0000FFFD    21             .equ    FAT_EBUSY,              0xfffd
                         0000FFFC    22             .equ    FAT_ENODEV,             0xfffc
                         0000FFFB    23             .equ    FAT_EIO,                0xfffb
                         0000FFFA    24             .equ    FAT_ENOENT,             0xfffa
                         0000FFF9    25             .equ    FAT_EEXIST,             0xfff9
                         0000FFF8    26             .equ    FAT_ENOSPC,             0xfff8
                         0000FFF7    27             .equ    FAT_EBADF,              0xfff7
                         0000FFF6    28             .equ    FAT_ENOTSUP,            0xfff6
                         0000FFF5    29             .equ    FAT_ENAMETOOLONG,       0xfff5
                         0000FFF4    30             .equ    FAT_ECORRUPT,           0xfff4
                         0000FFF3    31             .equ    FAT_EFBIG,              0xfff3
                                     32 
                                     33             ;; --- public constants -------------------------------------------
                         00000100    34             .equ    FAT_SECTOR_SIZE,        256
                         0000000B    35             .equ    FAT_SHORT_NAME_LEN,     11
                         00000002    36             .equ    FAT_CLUSTER_FIRST,      2
                         00000FF5    37             .equ    FAT_FAT12_LIMIT,        0x0ff5
                         00000001    38             .equ    FAT_ATTR_READ_ONLY,     0x01
                         00000008    39             .equ    FAT_ATTR_VOLUME_ID,     0x08
                         00000010    40             .equ    FAT_ATTR_DIRECTORY,     0x10
                         00000020    41             .equ    FAT_ATTR_ARCHIVE,       0x20
                         0000000F    42             .equ    FAT_ATTR_LFN,           0x0f
                         00000020    43             .equ    FAT_ENTRY_SIZE,         32
                         00000008    44             .equ    FAT_ENTRIES_PER_SECTOR, 8
                         0000000B    45             .equ    FAT_ENTRY_ATTR,         11
                         0000001A    46             .equ    FAT_ENTRY_CLUSTER,      26
                         0000001C    47             .equ    FAT_ENTRY_SIZE32,       28
                         000000E5    48             .equ    FAT_ENTRY_DELETED,      0xe5
                         00000000    49             .equ    FAT_ENTRY_END,          0x00
                         0000002E    50             .equ    FAT_DOT,                '.'
                         0000002F    51             .equ    FAT_SLASH,              '/'
                         00000020    52             .equ    FAT_SPACE,              ' '
                                     53 
                                     54             ;; --- worker configuration ---------------------------------------
                         00000020    55             .equ    FAT_WORKER_STACK,       32
                                     56 
                                     57             ;; --- fat_fs_t offsets (30 bytes) --------------------------------
                         00000000    58             .equ    FATFS_DEV,              0
                         00000002    59             .equ    FATFS_LBA_BASE,         2
                         00000004    60             .equ    FATFS_TOTAL_SECTORS,    4
                         00000006    61             .equ    FATFS_RESERVED,         6
                         00000008    62             .equ    FATFS_SECTORS_PER_FAT,  8
                         0000000A    63             .equ    FATFS_ROOT_ENTRIES,     10
                         0000000C    64             .equ    FATFS_ROOT_DIR_SECTORS, 12
                         0000000E    65             .equ    FATFS_FAT_START,        14
                         00000010    66             .equ    FATFS_ROOT_START,       16
                         00000012    67             .equ    FATFS_DATA_START,       18
                         00000014    68             .equ    FATFS_TOTAL_CLUSTERS,   20
                         00000016    69             .equ    FATFS_ALLOC_HINT,       22
                         00000018    70             .equ    FATFS_SECTORS_PER_CL,   24
                         00000019    71             .equ    FATFS_NUM_FATS,         25
                         0000001A    72             .equ    FATFS_FAT_BITS,         26
                         0000001B    73             .equ    FATFS_MOUNTED,          27
                         0000001C    74             .equ    FATFS_STATUS,           28
                         0000001E    75             .equ    FATFS_SIZE,             30
                                     76 
                                     77             ;; --- fat_dirent_t offsets (12 bytes) ----------------------------
                         00000000    78             .equ    FATDIRENT_FIRST_CLUSTER,0
                         00000002    79             .equ    FATDIRENT_SIZE,         2
                         00000006    80             .equ    FATDIRENT_DIR_SECTOR,   6
                         00000008    81             .equ    FATDIRENT_DIR_OFFSET,   8
                         00000009    82             .equ    FATDIRENT_ATTR,         9
                         0000000A    83             .equ    FATDIRENT_STATUS,       10
                         0000000C    84             .equ    FATDIRENT_SIZEOF,       12
                                     85 
                                     86             ;; --- fat_file_t offsets (18 bytes) ------------------------------
                                     87             ;; first 12 bytes intentionally match fat_dirent_t exactly.
                         00000000    88             .equ    FATFILE_FIRST_CLUSTER,  FATDIRENT_FIRST_CLUSTER
                         00000002    89             .equ    FATFILE_SIZE,           FATDIRENT_SIZE
                         00000006    90             .equ    FATFILE_DIR_SECTOR,     FATDIRENT_DIR_SECTOR
                         00000008    91             .equ    FATFILE_DIR_OFFSET,     FATDIRENT_DIR_OFFSET
                         00000009    92             .equ    FATFILE_ATTR,           FATDIRENT_ATTR
                         0000000A    93             .equ    FATFILE_STATUS,         FATDIRENT_STATUS
                         0000000C    94             .equ    FATFILE_FS,             12
                         0000000E    95             .equ    FATFILE_POS,            14
                         00000012    96             .equ    FATFILE_SIZEOF,         18
                                     97 
                                     98             ;; --- internal queued request layout -----------------------------
                                     99             ;; request header starts with a sysobj-compatible next/owner pair
                                    100             ;; so later process cleanup can walk the queue by owner.
                         00000000   101             .equ    FATREQ_NEXT,            0
                         00000002   102             .equ    FATREQ_OWNER,           2
                         00000004   103             .equ    FATREQ_OP,              4
                         00000005   104             .equ    FATREQ_FLAGS,           5
                         00000006   105             .equ    FATREQ_EVENT,           6
                         00000008   106             .equ    FATREQ_FS,              8
                         0000000A   107             .equ    FATREQ_DEV,             10
                         0000000C   108             .equ    FATREQ_BUF,             12
                         0000000E   109             .equ    FATREQ_BYTES,           14
                         00000010   110             .equ    FATREQ_ARG,             16
                         00000012   111             .equ    FATREQ_SIZE,            18
                                    112 
                         00000001   113             .equ    FATREQ_OP_MOUNT,        1
                         00000002   114             .equ    FATREQ_OP_LOOKUP,       2
                         00000003   115             .equ    FATREQ_OP_READ,         3
                         00000004   116             .equ    FATREQ_OP_WRITE,        4
                         00000005   117             .equ    FATREQ_OP_CREATE,       5
                                    118 
                         00000001   119             .equ    FATREQ_FLAG_FILE_ONLY,  0x01
                                    120 
                                    121             ;; --- scan helper return states ----------------------------------
                         00000000   122             .equ    FAT_SCAN_CONTINUE,      0
                         00000001   123             .equ    FAT_SCAN_FOUND,         1
                         00000002   124             .equ    FAT_SCAN_END,           2
                         00000000   125             .equ    FAT_WALK_LOOKUP,        0
                         00000001   126             .equ    FAT_WALK_CREATE,        1
                                    127 
                                    128             ;; --- boot sector offsets (FAT12/FAT16) --------------------------
                         0000000B   129             .equ    FATBOOT_BPS,            11
                         0000000D   130             .equ    FATBOOT_SPC,            13
                         0000000E   131             .equ    FATBOOT_RESERVED,       14
                         00000010   132             .equ    FATBOOT_NUM_FATS,       16
                         00000011   133             .equ    FATBOOT_ROOT_ENTRIES,   17
                         00000013   134             .equ    FATBOOT_TOTAL16,        19
                         00000016   135             .equ    FATBOOT_SECTORS_PER_FAT,22
                         00000020   136             .equ    FATBOOT_TOTAL32,        32
                         000000FE   137             .equ    FATBOOT_SIG_LO,         254
                         000000FF   138             .equ    FATBOOT_SIG_HI,         255
                                    139 
                                    140             ;; --- mbr partition table offsets within block 1 -----------------
                                    141             ;; the disk uses 256-byte physical transfers, so the standard PC
                                    142             ;; 512-byte MBR spans device blocks 0 and 1. the partition table
                                    143             ;; (offset 0x1be) and signature (offset 0x1fe) therefore live in
                                    144             ;; the SECOND 256-byte block at the offsets below.
                         000000BE   145             .equ    FATMBR_PART0,           190
                         00000010   146             .equ    FATMBR_PART_SIZE,       16
                         00000004   147             .equ    FATMBR_TYPE,            4
                         00000008   148             .equ    FATMBR_START,           8
                         0000000C   149             .equ    FATMBR_SIZE,            12
                         000000FE   150             .equ    FATMBR_SIG_LO,          254
                         000000FF   151             .equ    FATMBR_SIG_HI,          255
                                    152 
                                    153             ;; --- event / thread offsets pulled from kernel layout ----------
                         00000016   154             .equ    THREAD_PROCESS,         22
                         00000000   155             .equ    FAT_NONSIGNALED,        0
                         00000001   156             .equ    FAT_SIGNALED,           1
                         00000000   157             .equ    FAT_INIT_NONE,          0
                         00000001   158             .equ    FAT_INIT_BUSY,          1
                         00000002   159             .equ    FAT_INIT_READY,         2
                                     22 
                                     23             .globl  _fat_init
                                     24             .globl  _fat_mount_dev
                                     25             .globl  _fat_mount
                                     26             .globl  _find_dev_drv
                                     27 
                                     28             .globl  fat_ret_clean2$
                                     29             .globl  fat_alloc_req$
                                     30             .globl  fat_evt_reset$
                                     31             .globl  fat_complete_fs$
                                     32             .globl  fat_store_de$
                                     33             .globl  fat_load_de$
                                     34             .globl  fat_decode_req_evfdev$
                                     35             .globl  fat_queue_req$
                                     36             .globl  fat_req_base$
                                     37             .globl  fat_spc_shift$
                                     38             .globl  fat_prepare_fs_busy$
                                     39             .globl  fat_dev_open$
                                     40             .globl  fat_read_block$
                                     41             .globl  fat_work_fs$
                                     42             .globl  fat_work_dev$
                                     43             .globl  fat_work_event$
                                     44             .globl  fat_candidate_base$
                                     45             .globl  fat_cluster_shift$
                                     46             .globl  fat_spc_raw$
                                     47             .globl  fat_mbr_unsupported$
                                     48             .globl  fat_tmp_num_fats$
                                     49             .globl  fat_tmp_reserved$
                                     50             .globl  fat_tmp_root_entries$
                                     51             .globl  fat_tmp_spf$
                                     52             .globl  fat_tmp_total$
                                     53             .globl  fat_tmp_root_dir_sectors$
                                     54             .globl  fat_tmp_root_start$
                                     55             .globl  fat_tmp_data_start$
                                     56             .globl  fat_tmp_clusters$
                                     57             .globl  fat_sector$
                                     58 
                                     59             .globl  fat_handle_mount$
