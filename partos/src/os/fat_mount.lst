    00000207 7C               [ 4]  422             ld      a,h
    00000208 B5               [ 4]  423             or      l
    00000209 20 49            [12]  424             jr      nz,fmm_stop$
    0000020B CDr15r00         [17]  425             call    fat_boot_plausible$
    0000020E B7               [ 4]  426             or      a
    0000020F 20 21            [12]  427             jr      nz,fmm_parse$
                                    428 
    00000211 ED 5Br00r00      [20]  429             ld      de,(fat_candidate_base$)
