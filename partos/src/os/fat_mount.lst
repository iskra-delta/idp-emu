    0000023F C1               [10]  453             pop     bc
    00000240 11 10 00         [10]  454             ld      de,#FATMBR_PART_SIZE
    00000243 19               [11]  455             add     hl,de
    00000244 10 85            [13]  456             djnz    fmm_scan$
                                    457 
    00000246 3Ar00r00         [13]  458             ld      a,(fat_mbr_unsupported$)
    00000249 B7               [ 4]  459             or      a
    0000024A 20 04            [12]  460             jr      nz,fmm_notsup$
    0000024C 21 FA FF         [10]  461             ld      hl,#FAT_ENOENT
    0000024F C9               [10]  462             ret
    00000250                        463 fmm_notsup$:
    00000250 21 F6 FF         [10]  464             ld      hl,#FAT_ENOTSUP
    00000253 C9               [10]  465             ret
                                    466 
    00000254                        467 fmm_stop$:
    00000254 C1               [10]  468             pop     bc
    00000255 C1               [10]  469             pop     bc
    00000256 C9               [10]  470             ret
                                    471 
    00000257                        472 fmm_corrupt$:
