                                     61             .area   _CODE
                                     62 
                                     63             ;; ----------------------------------------------------------------
                                     64             ;; fat_spc_shift$(<a> sectors_per_cluster) -> <a> shift
                                     65             ;; ----------------------------------------------------------------
                                     66             ;; FAT requires sectors/cluster to be a power of two. later file
                                     67             ;; code can use the same shift to replace general division/multiply
                                     68             ;; with simple shifts. carry set = invalid value.
                                     69             ;; ----------------------------------------------------------------
    00000000                         70 fat_spc_shift$:
    00000000 B7               [ 4]   71             or      a
    00000001 28 10            [12]   72             jr      z,fss_invalid$
    00000003 06 00            [ 7]   73             ld      b,#0
    00000005                         74 fss_loop$:
    00000005 FE 01            [ 7]   75             cp      #1
    00000007 28 07            [12]   76             jr      z,fss_done$
    00000009 CB 3F            [ 8]   77             srl     a
    0000000B 38 06            [12]   78             jr      c,fss_invalid$      ; odd value > 1 => not a power of two
    0000000D 04               [ 4]   79             inc     b
    0000000E 18 F5            [12]   80             jr      fss_loop$
    00000010                         81 fss_done$:
    00000010 78               [ 4]   82             ld      a,b
    00000011 B7               [ 4]   83             or      a                   ; clear carry
    00000012 C9               [10]   84             ret
    00000013                         85 fss_invalid$:
    00000013 37               [ 4]   86             scf
    00000014 C9               [10]   87             ret
                                     88 
                                     89             ;; ----------------------------------------------------------------
                                     90             ;; fat_boot_plausible$() -> <a> 0/1
                                     91             ;; ----------------------------------------------------------------
                                     92             ;; fast low-cost filter used before we spend more code/data on full
                                     93             ;; parsing. it rejects obviously non-FAT blocks:
                                     94             ;;   - wrong 0x55aa signature
                                     95             ;;   - bytes/sector != 256
                                     96             ;;   - sectors/cluster not a power of two
                                     97             ;;   - mandatory FAT12/16 BPB fields missing
                                     98             ;;   - total sector count not representable in 16 bits today
                                     99             ;; ----------------------------------------------------------------
    00000015                        100 fat_boot_plausible$:
    00000015 3ArFEr00         [13]  101             ld      a,(fat_sector$ + FATBOOT_SIG_LO)
    00000018 FE 55            [ 7]  102             cp      #0x55
    0000001A 20 55            [12]  103             jr      nz,fbp_false$
    0000001C 3ArFFr00         [13]  104             ld      a,(fat_sector$ + FATBOOT_SIG_HI)
    0000001F FE AA            [ 7]  105             cp      #0xaa
    00000021 20 4E            [12]  106             jr      nz,fbp_false$
                                    107 
    00000023 3Ar0Br00         [13]  108             ld      a,(fat_sector$ + FATBOOT_BPS)
    00000026 B7               [ 4]  109             or      a
    00000027 20 48            [12]  110             jr      nz,fbp_false$
    00000029 3Ar0Cr00         [13]  111             ld      a,(fat_sector$ + FATBOOT_BPS + 1)
    0000002C FE 01            [ 7]  112             cp      #1
    0000002E 20 41            [12]  113             jr      nz,fbp_false$
                                    114 
    00000030 3Ar0Dr00         [13]  115             ld      a,(fat_sector$ + FATBOOT_SPC)
    00000033 CDr00r00         [17]  116             call    fat_spc_shift$
    00000036 38 39            [12]  117             jr      c,fbp_false$
                                    118 
    00000038 21r0Er00         [10]  119             ld      hl,#fat_sector$ + FATBOOT_RESERVED
    0000003B 7E               [ 7]  120             ld      a,(hl)
    0000003C 23               [ 6]  121             inc     hl
    0000003D B6               [ 7]  122             or      (hl)
    0000003E 28 31            [12]  123             jr      z,fbp_false$
                                    124 
    00000040 3Ar10r00         [13]  125             ld      a,(fat_sector$ + FATBOOT_NUM_FATS)
    00000043 B7               [ 4]  126             or      a
    00000044 28 2B            [12]  127             jr      z,fbp_false$
                                    128 
    00000046 21r11r00         [10]  129             ld      hl,#fat_sector$ + FATBOOT_ROOT_ENTRIES
    00000049 7E               [ 7]  130             ld      a,(hl)
    0000004A 23               [ 6]  131             inc     hl
    0000004B B6               [ 7]  132             or      (hl)
    0000004C 28 23            [12]  133             jr      z,fbp_false$
                                    134 
    0000004E 21r16r00         [10]  135             ld      hl,#fat_sector$ + FATBOOT_SECTORS_PER_FAT
    00000051 7E               [ 7]  136             ld      a,(hl)
    00000052 23               [ 6]  137             inc     hl
    00000053 B6               [ 7]  138             or      (hl)
    00000054 28 1B            [12]  139             jr      z,fbp_false$
                                    140 
    00000056 21r13r00         [10]  141             ld      hl,#fat_sector$ + FATBOOT_TOTAL16
    00000059 7E               [ 7]  142             ld      a,(hl)
    0000005A 23               [ 6]  143             inc     hl
    0000005B B6               [ 7]  144             or      (hl)
    0000005C 20 10            [12]  145             jr      nz,fbp_true$
                                    146 
    0000005E 21r22r00         [10]  147             ld      hl,#fat_sector$ + FATBOOT_TOTAL32 + 2
    00000061 7E               [ 7]  148             ld      a,(hl)
    00000062 23               [ 6]  149             inc     hl
    00000063 B6               [ 7]  150             or      (hl)
    00000064 20 0B            [12]  151             jr      nz,fbp_false$
                                    152 
    00000066 21r20r00         [10]  153             ld      hl,#fat_sector$ + FATBOOT_TOTAL32
    00000069 7E               [ 7]  154             ld      a,(hl)
    0000006A 23               [ 6]  155             inc     hl
    0000006B B6               [ 7]  156             or      (hl)
    0000006C 28 03            [12]  157             jr      z,fbp_false$
                                    158 
    0000006E                        159 fbp_true$:
    0000006E 3E 01            [ 7]  160             ld      a,#1
    00000070 C9               [10]  161             ret
    00000071                        162 fbp_false$:
    00000071 AF               [ 4]  163             xor     a
    00000072 C9               [10]  164             ret
                                    165 
                                    166             ;; ----------------------------------------------------------------
                                    167             ;; fat_fill_fs_from_boot$(<hl> fs, <de> lba_base256) -> <hl> rc
                                    168             ;; ----------------------------------------------------------------
                                    169             ;; full metadata parse once fat_boot_plausible$ said "this looks
                                    170             ;; like a FAT boot sector". the function still validates carefully
                                    171             ;; and returns a real FAT_* status.
                                    172             ;;
                                    173             ;; stored values stay volume-relative except for lba_base; later I/O
                                    174             ;; code will add lba_base when talking to the block driver.
                                    175             ;; ----------------------------------------------------------------
    00000073                        176 fat_fill_fs_from_boot$:
    00000073 D5               [11]  177             push    de                  ; keep lba_base safe across parsing
                                    178 
                                    179             ;; fat_boot_plausible$ already validated signature, 256-byte
                                    180             ;; sectors and a legal power-of-two sectors/cluster value.
    00000074 3Ar0Dr00         [13]  181             ld      a,(fat_sector$ + FATBOOT_SPC)
    00000077 32r00r00         [13]  182             ld      (fat_spc_raw$),a
    0000007A CDr00r00         [17]  183             call    fat_spc_shift$
    0000007D 32r00r00         [13]  184             ld      (fat_cluster_shift$),a
                                    185 
                                    186             ;; load the BPB fields we rely on. the cheap zero/high-half checks
                                    187             ;; were already done by fat_boot_plausible$ on the same sector.
    00000080 21r0Er00         [10]  188             ld      hl,#fat_sector$ + FATBOOT_RESERVED
    00000083 CDr00r00         [17]  189             call    fat_load_de$
    00000086 ED 53r00r00      [20]  190             ld      (fat_tmp_reserved$),de
                                    191 
    0000008A 3Ar10r00         [13]  192             ld      a,(fat_sector$ + FATBOOT_NUM_FATS)
    0000008D 32r00r00         [13]  193             ld      (fat_tmp_num_fats$),a
                                    194 
    00000090 21r11r00         [10]  195             ld      hl,#fat_sector$ + FATBOOT_ROOT_ENTRIES
    00000093 CDr00r00         [17]  196             call    fat_load_de$
    00000096 ED 53r00r00      [20]  197             ld      (fat_tmp_root_entries$),de
                                    198 
    0000009A 21r16r00         [10]  199             ld      hl,#fat_sector$ + FATBOOT_SECTORS_PER_FAT
    0000009D CDr00r00         [17]  200             call    fat_load_de$
    000000A0 ED 53r00r00      [20]  201             ld      (fat_tmp_spf$),de
                                    202 
                                    203             ;; total sector count: prefer total16, otherwise use total32 low.
    000000A4 21r13r00         [10]  204             ld      hl,#fat_sector$ + FATBOOT_TOTAL16
    000000A7 CDr00r00         [17]  205             call    fat_load_de$
    000000AA 7A               [ 4]  206             ld      a,d
    000000AB B3               [ 4]  207             or      e
    000000AC 20 06            [12]  208             jr      nz,ffb_have_total$
    000000AE 21r20r00         [10]  209             ld      hl,#fat_sector$ + FATBOOT_TOTAL32
    000000B1 CDr00r00         [17]  210             call    fat_load_de$
    000000B4                        211 ffb_have_total$:
    000000B4 ED 53r00r00      [20]  212             ld      (fat_tmp_total$),de
                                    213 
                                    214             ;; root_dir_sectors = ceil(root_entries / 8) = (root_entries + 7)>>3
    000000B8 ED 5Br00r00      [20]  215             ld      de,(fat_tmp_root_entries$)
    000000BC 7B               [ 4]  216             ld      a,e
    000000BD C6 07            [ 7]  217             add     a,#7
    000000BF 5F               [ 4]  218             ld      e,a
    000000C0 30 01            [12]  219             jr      nc,ffb_rds_ready$
    000000C2 14               [ 4]  220             inc     d
    000000C3                        221 ffb_rds_ready$:
    000000C3 CB 3A            [ 8]  222             srl     d
    000000C5 CB 1B            [ 8]  223             rr      e
    000000C7 CB 3A            [ 8]  224             srl     d
    000000C9 CB 1B            [ 8]  225             rr      e
    000000CB CB 3A            [ 8]  226             srl     d
    000000CD CB 1B            [ 8]  227             rr      e
    000000CF ED 53r00r00      [20]  228             ld      (fat_tmp_root_dir_sectors$),de
    000000D3 E5               [11]  229             push    hl
    000000D4 01 0C 00         [10]  230             ld      bc,#FATFS_ROOT_DIR_SECTORS
    000000D7 09               [11]  231             add     hl,bc
    000000D8 CDr00r00         [17]  232             call    fat_store_de$
    000000DB E1               [10]  233             pop     hl
                                    234 
                                    235             ;; fat_start = reserved_sectors
    000000DC ED 5Br00r00      [20]  236             ld      de,(fat_tmp_reserved$)
    000000E0 E5               [11]  237             push    hl
    000000E1 01 0E 00         [10]  238             ld      bc,#FATFS_FAT_START
    000000E4 09               [11]  239             add     hl,bc
    000000E5 CDr00r00         [17]  240             call    fat_store_de$
    000000E8 E1               [10]  241             pop     hl
                                    242 
                                    243             ;; root_start = reserved + num_fats * sectors_per_fat
    000000E9 2Ar00r00         [16]  244             ld      hl,(fat_tmp_reserved$)
    000000EC ED 5Br00r00      [20]  245             ld      de,(fat_tmp_spf$)
    000000F0 3Ar00r00         [13]  246             ld      a,(fat_tmp_num_fats$)
    000000F3                        247 ffb_root_loop$:
    000000F3 B7               [ 4]  248             or      a
    000000F4 28 04            [12]  249             jr      z,ffb_root_done$
    000000F6 19               [11]  250             add     hl,de
    000000F7 3D               [ 4]  251             dec     a
    000000F8 18 F9            [12]  252             jr      ffb_root_loop$
    000000FA                        253 ffb_root_done$:
    000000FA 22r00r00         [16]  254             ld      (fat_tmp_root_start$),hl
                                    255 
                                    256             ;; data_start = root_start + root_dir_sectors
    000000FD ED 5Br00r00      [20]  257             ld      de,(fat_tmp_root_dir_sectors$)
    00000101 19               [11]  258             add     hl,de
    00000102 22r00r00         [16]  259             ld      (fat_tmp_data_start$),hl
                                    260 
                                    261             ;; data_start must lie inside the volume.
    00000105 EB               [ 4]  262             ex      de,hl               ; de = data_start
    00000106 2Ar00r00         [16]  263             ld      hl,(fat_tmp_total$)
    00000109 B7               [ 4]  264             or      a
    0000010A ED 52            [15]  265             sbc     hl,de
    0000010C DArA1r01         [10]  266             jp      c,ffb_corrupt_pop$
