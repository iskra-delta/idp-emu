    00000216 E6 80            [ 7]  431             and     #0x80              ; doubling would overflow 16 bits
    00000218 20 24            [12]  432             jr      nz,fmm_next$
    0000021A CB 23            [ 8]  433             sla     e
    0000021C CB 12            [ 8]  434             rl      d
    0000021E ED 53r00r00      [20]  435             ld      (fat_candidate_base$),de
    00000222 2Ar00r00         [16]  436             ld      hl,(fat_work_dev$)
    00000225 CDr00r00         [17]  437             call    fat_read_block$
    00000228 7C               [ 4]  438             ld      a,h
    00000229 B5               [ 4]  439             or      l
    0000022A 20 28            [12]  440             jr      nz,fmm_stop$
    0000022C CDr15r00         [17]  441             call    fat_boot_plausible$
    0000022F B7               [ 4]  442             or      a
    00000230 28 0C            [12]  443             jr      z,fmm_next$
                                    444 
    00000232                        445 fmm_parse$:
    00000232 2Ar00r00         [16]  446             ld      hl,(fat_work_fs$)
    00000235 ED 5Br00r00      [20]  447             ld      de,(fat_candidate_base$)
